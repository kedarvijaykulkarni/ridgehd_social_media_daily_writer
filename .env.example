# Ollama connection
OLLAMA_HOST=http://localhost:11434

# Installed locally as of 2026-07-13: qwen2.5-coder:7b, qwen2.5-coder:1.5b,
# qwen3-coder:30b, qwen3.5:35b, gemma4:latest, all-minilm (embedding only, not
# usable here). gemma4:latest is the default here: general-purpose and fast
# enough to run daily. qwen3.5:35b is higher quality but much slower (36B) —
# swap it in if you want better copy and don't mind the wait. The qwen*-coder
# models are tuned for code, not marketing copy — avoid them for this tool.
OLLAMA_MODEL=gemma4:latest

# Paths — relative paths resolve against this package's own directory
# (apps/social-daily/). Defaults point at the repo-root marketing/ folder
# that Prompt 1 (docs/prompt-1-claude-cli-knowledge-base.md) produces.
KNOWLEDGE_BASE_PATH=../../marketing/knowledge-base.json
POST_HISTORY_PATH=../../marketing/post-history.json
OUTPUT_DIR=./output
