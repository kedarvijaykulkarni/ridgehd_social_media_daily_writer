# Ollama connection
OLLAMA_HOST=http://localhost:11434

# Installed locally as of 2026-07-13: qwen2.5-coder:7b, qwen2.5-coder:1.5b,
# qwen3-coder:30b, qwen3.5:35b, gemma4:latest, all-minilm (embedding only, not
# usable here). gemma4:latest is the default here: general-purpose and fast
# enough to run daily. qwen3.5:35b is higher quality but much slower (36B) —
# swap it in if you want better copy and don't mind the wait. The qwen*-coder
# models are tuned for code, not marketing copy — avoid them for this tool.
OLLAMA_MODEL=gemma4:latest

# --- Business knowledge base --------------------------------------------
# Absolute path to your local checkout of the RidgeHQ business Obsidian
# vault (the directory that contains `wiki/`). The app reads
# wiki/business-context.md, wiki/competitors.md and wiki/pricing.md from
# here at runtime to build the day's topic list — see
# docs/business-context-reference.md. This path is machine-specific, which
# is why it lives here in .env and not in source.
BUSINESS_VAULT_PATH=D:\work\RidgeHQAPP\Brain\RidgeHQAPP

# Product name used in every generated prompt and draft. Defaults to
# "AquaRoster". The business vault documents the product as "RidgeHQ" /
# "RidgeHQAPP", but flags that ridgehq.com is an unrelated active business
# (name-collision risk) — so don't switch this to RidgeHQ for public copy
# until the name is cleared. See CLAUDE.md.
PRODUCT_NAME=AquaRoster

# --- Local paths ------------------------------------------------------
# Relative paths resolve against this package's own directory.
# post-history.json is this tool's own read+write coverage state; it lives
# in ./data (gitignored, transient) — not in the vault, whose pages are
# either immutable sources or LLM-maintained prose.
POST_HISTORY_PATH=./data/post-history.json
OUTPUT_DIR=./output
